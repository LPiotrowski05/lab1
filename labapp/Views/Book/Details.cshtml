@model Book
@{
    ViewData["Title"] = "Szczegóły książki";
}
<h2>Szczegóły książki nr @Model.Id</h2>
<dl class="row">
    <dt class="col-sm-3">Tytuł</dt><dd class="col-sm-9">@Model.Title</dd>
    <dt class="col-sm-3">Autor</dt><dd class="col-sm-9">@Model.Author</dd>
    <dt class="col-sm-3">ISBN</dt><dd class="col-sm-9">@Model.Isbn</dd>
    <dt class="col-sm-3">Data wydania</dt><dd class="col-sm-9">@Model.PublicationDate?.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Liczba stron</dt><dd class="col-sm-9">@Model.NumPages</dd>
    <dt class="col-sm-3">Cena</dt><dd class="col-sm-9">@Model.Price.ToString("C")</dd>
</dl>
<a asp-action="Index" class="btn btn-secondary">Wróć do listy</a>